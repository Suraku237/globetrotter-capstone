// Two agents by design: the Windows PC (labeled below) has a working
// Flutter install and real CPU/RAM headroom, so it does the actual build.
// The VPS (built-in node) only receives the already-built static files and
// copies them into place — it never runs Flutter/Gradle itself, which is
// what made builds on the VPS alone crawl to a halt.
pipeline {
    agent none

    // The default per-stage-agent checkout does a full clone (entire git
    // history — every image/video/APK ever committed, even long-deleted
    // ones, ~150MB+ here). On a slow/unstable connection that repeatedly
    // blew past Jenkins' checkout retry limit before finishing. Disabled
    // here in favor of an explicit shallow clone (depth 1) in the one
    // stage that actually needs the source.
    options {
        skipDefaultCheckout()
    }

    environment {
        // Must match the label given to the PC's node in Jenkins
        // (Manage Jenkins > Nodes > New Node).
        PC_AGENT_LABEL = 'flutter-pc'
        WEB_DEPLOY_DIR = '/var/www/fasttravel-app'
    }

    stages {
        stage('Build (PC)') {
            agent { label "${PC_AGENT_LABEL}" }
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [[$class: 'CloneOption', shallow: true, depth: 1, noTags: false, timeout: 30]],
                    userRemoteConfigs: [[url: 'https://github.com/Suraku237/globetrotter-capstone', credentialsId: 'github-creds']]
                ])
                dir('frontend/fast_travel') {
                    bat 'flutter pub get'
                    // Only real analyzer ERRORs block the deploy —
                    // pre-existing style lints don't affect correctness.
                    bat 'flutter analyze --no-fatal-warnings --no-fatal-infos'
                    bat 'flutter test'
                    bat 'flutter build web --release'
                }
                stash name: 'web-build', includes: 'frontend/fast_travel/build/web/**'
            }
        }

        stage('Deploy (VPS)') {
            // If your Jenkins controller's built-in node uses a different
            // label than "built-in" (check Manage Jenkins > Nodes), update
            // this to match. No checkout needed here — this stage only
            // copies the files the PC stage already built (via unstash).
            agent { label 'built-in' }
            steps {
                unstash 'web-build'
                sh '''
                    mkdir -p ${WEB_DEPLOY_DIR}/downloads
                    # Clear out everything except downloads/ (the APK lives
                    # there — this pipeline only builds the web app, so it
                    # has no business touching that folder).
                    find ${WEB_DEPLOY_DIR} -mindepth 1 -maxdepth 1 ! -name downloads -exec rm -rf {} +
                    cp -r frontend/fast_travel/build/web/* ${WEB_DEPLOY_DIR}/
                    # chmod, not chown: the Jenkins user owns these files
                    # already (it just wrote them) — granting read access to
                    # everyone is enough for nginx (www-data) to serve them,
                    # and unlike chown it doesn't require root.
                    chmod -R o+rX ${WEB_DEPLOY_DIR}
                '''
            }
        }
    }

    post {
        success {
            slackSend(
                color: 'good',
                message: "✅ Frontend web deploy succeeded: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})"
            )
            emailext(
                subject: "✅ Frontend web deploy succeeded - build #${env.BUILD_NUMBER}",
                body: "The frontend web deploy pipeline succeeded.\n\nBuild: ${env.BUILD_URL}",
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
        failure {
            slackSend(
                color: 'danger',
                message: "❌ Frontend web deploy FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})"
            )
            emailext(
                subject: "❌ Frontend web deploy FAILED - build #${env.BUILD_NUMBER}",
                body: "The frontend web deploy pipeline failed. Check logs.\n\nBuild: ${env.BUILD_URL}",
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
    }
}
