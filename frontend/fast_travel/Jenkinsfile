pipeline {
    agent any

    environment {
        DEPLOY_DIR = '/opt/fast_travel_micro'
        // pubspec.yaml's maplibre_gl constraint needs Dart >=3.7.0 — "stable"
        // tracks current Flutter releases so this stays satisfied without a
        // hardcoded version number going stale.
        FLUTTER_IMAGE = 'ghcr.io/cirruslabs/flutter:stable'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                // Runs analyze + the widget test suite inside the Flutter
                // Docker image, so the Jenkins/VPS host itself never needs
                // Flutter or the Android SDK installed.
                sh '''
                    cd frontend/fast_travel
                    docker run --rm -v "$PWD":/app -w /app ${FLUTTER_IMAGE} \
                        sh -c "flutter pub get && flutter analyze && flutter test"
                '''
            }
        }

        stage('Build') {
            steps {
                // Builds the release web bundle and a debug APK together —
                // see frontend/fast_travel/Dockerfile.
                sh '''
                    cd frontend/fast_travel
                    docker compose build
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cd ${DEPLOY_DIR}
                    git fetch --all
                    git reset --hard origin/main
                    cd frontend/fast_travel
                    docker compose up -d --build
                    docker image prune -f
                '''
            }
        }
    }

    post {
        success {
            slackSend(
                color: 'good',
                message: "✅ Frontend deploy succeeded: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})"
            )
            emailext(
                subject: "✅ Frontend deploy succeeded - build #${env.BUILD_NUMBER}",
                body: "The frontend deploy pipeline succeeded.\n\nBuild: ${env.BUILD_URL}",
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
        failure {
            slackSend(
                color: 'danger',
                message: "❌ Frontend deploy FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})"
            )
            emailext(
                subject: "❌ Frontend deploy FAILED - build #${env.BUILD_NUMBER}",
                body: "The frontend deploy pipeline failed. Check logs.\n\nBuild: ${env.BUILD_URL}",
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
    }
}
