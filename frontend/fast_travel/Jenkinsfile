// Frontend deploy pipeline for the Flutter web app served at
// fasttravel-web.duckdns.org. Runs on the same Jenkins agent as the
// backend pipeline (which is the VPS itself), so "deploy" is a local
// rsync of the compiled build/web/ output into the nginx doc root.
//
// This file used to be a byte-for-byte copy of the backend Jenkinsfile,
// which meant every "frontend-deploy" build silently redeployed the
// backend and left the Flutter web files untouched — that's why the
// site kept showing an old build even after every "successful"
// frontend build. The pipeline below actually builds Flutter web now.

pipeline {
    agent any

    environment {
        // Persistent Flutter SDK checkout — cloned on the first build,
        // reused on every subsequent build so we don't re-download
        // ~1 GB of Dart SDK each time.
        FLUTTER_HOME = "${env.HOME}/flutter-sdk"
        // Nginx serves the Flutter web bundle from this directory (see
        // /etc/nginx/sites-enabled/fasttravel-web on the VPS). rsync
        // writes into it with --delete so old bundle files can't linger
        // and confuse the browser's cache-busting logic.
        WEB_DIR = '/var/www/fasttravel-web'
        APP_DIR = 'frontend/fast_travel'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install prerequisites') {
            steps {
                // Flutter's first-run bootstrap downloads the Dart SDK
                // as a .zip and extracts it with `unzip`; some pub
                // packages ship .tar.xz artifacts that need `xz-utils`.
                // Neither is guaranteed to be present on a fresh VPS,
                // and their absence is exactly the failure this stage
                // guards against ("Missing \"unzip\" tool. Unable to
                // extract Dart SDK.").
                //
                // Auto-install only works when the jenkins user has
                // passwordless sudo for apt-get. If it doesn't, we
                // fail fast with a clear one-time fix instead of the
                // confusing "sudo: a password is required" traceback.
                sh '''
                    set -e
                    need_install=""
                    command -v unzip >/dev/null 2>&1 || need_install="$need_install unzip"
                    command -v xz     >/dev/null 2>&1 || need_install="$need_install xz-utils"

                    if [ -z "$need_install" ]; then
                        echo "unzip and xz already installed — nothing to do."
                        exit 0
                    fi

                    echo "Missing packages:$need_install"

                    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
                        echo "Passwordless sudo available — installing automatically."
                        sudo -n apt-get update -y
                        sudo -n apt-get install -y $need_install
                    elif [ "$(id -u)" = "0" ]; then
                        apt-get update -y
                        apt-get install -y $need_install
                    else
                        echo ""
                        echo "ERROR: Cannot install missing packages automatically."
                        echo "The Jenkins user lacks passwordless sudo, so this"
                        echo "pipeline cannot self-heal. Run ONE of the following"
                        echo "on the VPS as a user with sudo, then re-run the build:"
                        echo ""
                        echo "  # Option 1 - one-time install (simplest):"
                        echo "  sudo apt-get update && sudo apt-get install -y unzip xz-utils"
                        echo ""
                        echo "  # Option 2 - let Jenkins install packages itself:"
                        echo "  sudo sh -c \"echo 'jenkins ALL=(root) NOPASSWD: /usr/bin/apt-get' > /etc/sudoers.d/jenkins-apt\""
                        echo "  sudo chmod 0440 /etc/sudoers.d/jenkins-apt"
                        echo ""
                        exit 1
                    fi

                    unzip -v | head -1
                    xz --version | head -1
                '''
            }
        }

        stage('Setup Flutter') {
            steps {
                sh '''
                    set -e
                    if [ ! -d "$FLUTTER_HOME" ]; then
                        echo "First-time Flutter setup — cloning stable channel."
                        git clone --depth 1 -b stable https://github.com/flutter/flutter.git "$FLUTTER_HOME"
                    fi
                    export PATH="$FLUTTER_HOME/bin:$PATH"

                    # Ownership of the SDK path itself matters for
                    # `flutter upgrade` — refuses to run otherwise.
                    # `config --no-analytics` silences the interactive
                    # first-run prompt that would otherwise hang.
                    git config --global --add safe.directory "$FLUTTER_HOME"
                    flutter config --no-analytics --enable-web
                    flutter --version
                '''
            }
        }

        stage('Build web') {
            steps {
                sh '''
                    set -e
                    export PATH="$FLUTTER_HOME/bin:$PATH"
                    cd "$APP_DIR"

                    # Wipe generated caches from previous builds before
                    # `flutter pub get`. If an earlier build (or a manual
                    # run) touched these as root, jenkins can't overwrite
                    # the files inside — but it CAN delete them, because
                    # the parent directory is a jenkins-owned git
                    # checkout. Doing this every build keeps the
                    # workspace hermetic and cheap (Flutter re-resolves
                    # from the pub cache in ~/.pub-cache, which is
                    # untouched).
                    rm -rf .dart_tool build .flutter-plugins .flutter-plugins-dependencies

                    flutter pub get
                    # --release: minified + tree-shaken, smaller bundle
                    # for production. Icon tree-shaking sometimes trips
                    # up on the Cameroon flag emoji + Material Symbols
                    # combo, hence --no-tree-shake-icons.
                    flutter build web --release --no-tree-shake-icons
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    set -e
                    if [ ! -d "$WEB_DIR" ]; then
                        echo "Target directory $WEB_DIR does not exist."
                        echo "Create it once on the VPS with:"
                        echo "  sudo mkdir -p $WEB_DIR"
                        echo "  sudo chown jenkins:www-data $WEB_DIR"
                        echo "  sudo chmod g+ws $WEB_DIR"
                        exit 1
                    fi
                    # --delete removes stale files from a previous
                    # bundle (Flutter web uses hashed filenames per
                    # build, so keeping them around forever would grow
                    # the doc root without limit).
                    rsync -a --delete "$APP_DIR/build/web/" "$WEB_DIR/"

                    # Best-effort ownership + group-read flags so nginx
                    # (running as www-data) can serve everything.
                    # Ignored if the Jenkins user lacks permission — in
                    # that case the doc root should already be set up so
                    # files are readable regardless.
                    chown -R jenkins:www-data "$WEB_DIR" 2>/dev/null || true
                    chmod -R g+r "$WEB_DIR" 2>/dev/null || true
                '''
            }
        }
    }

    post {
        success {
            script {
                try {
                    slackSend(
                        color: 'good',
                        message: "Frontend deploy succeeded: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})"
                    )
                } catch (err) {
                    echo "Slack not configured yet - ignoring: ${err}"
                }
            }
            emailext(
                subject: "Frontend deploy succeeded - build #${env.BUILD_NUMBER}",
                body: "The Flutter web deploy pipeline succeeded.\n\nBuild: ${env.BUILD_URL}",
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
        failure {
            script {
                try {
                    slackSend(
                        color: 'danger',
                        message: "Frontend deploy FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})"
                    )
                } catch (err) {
                    echo "Slack not configured yet - ignoring: ${err}"
                }
            }
            emailext(
                subject: "Frontend deploy FAILED - build #${env.BUILD_NUMBER}",
                body: "The Flutter web deploy pipeline failed. Check logs.\n\nBuild: ${env.BUILD_URL}",
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
    }
}
