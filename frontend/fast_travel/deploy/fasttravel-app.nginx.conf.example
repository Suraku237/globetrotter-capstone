# One-time manual setup on the VPS — this file is NOT applied automatically.
# GitHub Actions (.github/workflows/deploy-frontend.yml) only keeps
# /var/www/fasttravel-app up to date with the latest build on every push;
# it never touches nginx config. Routing your domain there is a one-off step.
#
# If your DuckDNS domain already has a server block in sites-available
# (e.g. because it used to serve the marketing site directly), just copy the
# `location /` and `location /downloads/` blocks below into that existing
# server block instead of adding a new file — nginx will reject two server
# blocks claiming the same server_name on the same port.
#
# Otherwise, to add it as a new site:
#   1. Copy this file to /etc/nginx/sites-available/fasttravel-app
#   2. Replace YOUR_DOMAIN.duckdns.org below with your actual domain
#   3. Enable it and reload nginx:
#        sudo ln -s /etc/nginx/sites-available/fasttravel-app /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name YOUR_DOMAIN.duckdns.org;
    root /var/www/fasttravel-app;
    index index.html;

    location /downloads/ {
        autoindex on;
    }

    # Flutter web is a single-page app — unmatched paths fall back to
    # index.html so client-side routing and hard refreshes don't 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
