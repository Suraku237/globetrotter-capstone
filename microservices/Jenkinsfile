pipeline {
    agent any

    environment {
        DEPLOY_DIR = '/opt/fast_travel_micro'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh '''
                    cd microservices/data-service
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --no-cache-dir -r requirements-dev.txt
                    JWT_SECRET=ci-test-secret python -m pytest tests -v
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    cd microservices
                    docker compose -f docker-compose.yml build
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cd ${DEPLOY_DIR}
                    git fetch --all
                    git reset --hard origin/main
                    cd microservices

                    # Generate the JWT signing secret once; reused on every later deploy.
                    if [ ! -f .env ]; then
                        echo "JWT_SECRET=$(openssl rand -hex 32)" > .env
                        echo "Generated new JWT_SECRET (first deploy on this host)"
                    fi

                    # Always leave a real file here — docker compose turns a missing
                    # bind-mount source into an empty directory, which breaks the
                    # container. An empty file is harmless: Google sign-in just stays
                    # disabled (register/login are unaffected) until a real credential
                    # is configured below.
                    touch -a firebase-service-account.json
                '''

                // Optional: only copies a real credential over the placeholder if the
                // 'firebase-service-account' Secret file credential has been added in
                // Jenkins. If it hasn't, the deploy still proceeds — Google sign-in
                // just isn't available yet.
                script {
                    try {
                        withCredentials([file(credentialsId: 'firebase-service-account', variable: 'FIREBASE_CRED_FILE')]) {
                            sh 'cp "$FIREBASE_CRED_FILE" ${DEPLOY_DIR}/microservices/firebase-service-account.json'
                        }
                    } catch (err) {
                        echo "No 'firebase-service-account' Jenkins credential configured — Google sign-in stays disabled. Email/password auth is unaffected."
                    }
                }

                sh '''
                    cd ${DEPLOY_DIR}/microservices
                    docker compose up -d --build
                    docker image prune -f
                '''
            }
        }
    }

    post {
        success {
            slackSend(
                color: 'good',
                message: "✅ Backend deploy succeeded: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})"
            )
            emailext(
                subject: "✅ Backend deploy succeeded - build #${env.BUILD_NUMBER}",
                body: "The backend deploy pipeline succeeded.\n\nBuild: ${env.BUILD_URL}",
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
        failure {
            slackSend(
                color: 'danger',
                message: "❌ Backend deploy FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})"
            )
            emailext(
                subject: "❌ Backend deploy FAILED - build #${env.BUILD_NUMBER}",
                body: "The backend deploy pipeline failed. Check logs.\n\nBuild: ${env.BUILD_URL}",
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
    }
}
